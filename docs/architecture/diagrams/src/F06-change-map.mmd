    classDef accepted fill:#dcfce7,stroke:#15803d,color:#111827;
    class UGEN,UALIGN,UINDEX,UOUT upstream;
    class PGEN,INSERT,VALIDATE,PUBLISH,AFFINITY,CHUNKS,NUMA,TRANSCRIPT accepted;
