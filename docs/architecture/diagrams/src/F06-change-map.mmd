flowchart LR
    subgraph UPSTREAM["STAR 2.7.11b inherited core"]
        UGEN["genomeGenerate"]
        UALIGN["alignReads"]
        UINDEX[("Conventional index format")]
        UOUT["SAM / BAM and counts"]
        UGEN --> UINDEX --> UALIGN --> UOUT
    end

    subgraph ACCEPTED["BlackSTAR blackstar.1 accepted additions"]
        PGEN["Parallel and memory-adaptive<br/>SA, SAindex, and junction stages"]
        INSERT["Persistent named-sequence insertion<br/>Full / Overlay / Delta"]
        VALIDATE["Strong identity, strict manifests,<br/>payload validation"]
        PUBLISH["Atomic publication and<br/>checksum-pinned selection"]
        PGEN --> INSERT --> VALIDATE --> PUBLISH
    end

    UGEN -->|accelerated; byte-identical v1 output| PGEN
    UINDEX -->|base input| INSERT
    VALIDATE -->|validated package| UALIGN
    UALIGN -. "normal alignment semantics preserved" .-> UOUT

    classDef upstream fill:#f3f4f6,stroke:#4b5563,color:#111827;
