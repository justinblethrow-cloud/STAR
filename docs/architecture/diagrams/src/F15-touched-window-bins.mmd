flowchart TB
    subgraph BEFORE["Qualified release: reset every read"]
        direction LR
        BREAD["Begin next read"] --> BCLEAR["Clear every slot in both<br/>window-bin arrays"]
        BCLEAR --> BBUILD["Build and merge alignment windows"]
        BBUILD --> BWRITE["Write the bins used by this read"]
    end

    subgraph AFTER["A01 experiment: sparse reset"]
        direction LR
        AREAD["Begin next read"] --> ACLEAR["Restore only bins recorded<br/>by the previous read"]
        ACLEAR --> ABUILD["Build and merge alignment windows"]
        ABUILD --> AFIRST{"Slot was empty?"}
        AFIRST -->|Yes| ARECORD["Record bin and strand once"]
        AFIRST -->|No| AWRITE["Preserve overwrite semantics"]
        ARECORD --> AWRITE
    end

    BCLEAR ~~~ ACLEAR

    subgraph NOTES["Experiment boundary"]
        direction LR
        STATUS["EXCLUDED<br/>Correctness passed<br/>performance effect invalidated"]
        INVARIANT["Preserved: window IDs, merge order,<br/>scoring, output, and thread ownership"]
        STATUS --- INVARIANT
    end
    AWRITE -.-> STATUS

    classDef baseline fill:#f3f4f6,stroke:#4b5563,color:#111827;
    classDef experiment fill:#dbeafe,stroke:#1d4ed8,color:#111827;
    classDef decision fill:#fef3c7,stroke:#a16207,color:#111827;
    classDef invariant fill:#dcfce7,stroke:#15803d,color:#111827;
    classDef note fill:#ffffff,stroke:#6b7280,color:#374151,stroke-dasharray: 5 5;
    classDef rejected fill:#fee2e2,stroke:#b91c1c,color:#111827;
    class BREAD,BCLEAR,BBUILD,BWRITE baseline;
    class AREAD,ACLEAR,ABUILD,ARECORD,AWRITE experiment;
    class AFIRST decision;
    class INVARIANT invariant;
    class STATUS rejected;
