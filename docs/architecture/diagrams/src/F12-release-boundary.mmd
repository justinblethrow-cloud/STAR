flowchart TD
    CAND["BlackSTAR release candidate"] --> BUILD["Build identity<br/>fork version + OpenMP + checksum"]
    BUILD --> SAN["Focused ASan / UBSan tests"]
    SAN --> RUNTIME["Alignment runtime gates<br/>ordinary + bound affinity<br/>private + shared genome<br/>raw + zcat + canonical BAM"]
    RUNTIME --> FORMAT{"Format path"}
    FORMAT -->|v1 unchanged| BYTE["Byte identity against oracle"]
    FORMAT -->|Overlay / Delta| MAP["Mapping, junction, and count equivalence"]
    BYTE --> ADV["Adversarial malformed-package rejection"]
    MAP --> ADV
    ADV --> PERF["Randomized paired full-size benchmark"]
    PERF --> DEPLOY["Canary, fallback, and rollback"]
    DEPLOY --> RELEASE["QUALIFIED RELEASE BOUNDARY"]

    EXCLUDED["EXCLUDED EXPERIMENTS<br/>alignReadsMulti<br/>persistent prefork workers<br/>threaded BAM compression"] -. "not release capability" .-> RELEASE

