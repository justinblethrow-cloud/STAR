flowchart TB
    subgraph ATTRIBUTION["Post-A02 attribution"]
        direction LR
        PARSER["Serialized parser remains"]
        UTIL["94.16 equivalent mapping CPUs<br/>0.75 worker-equivalents lock wait"]
