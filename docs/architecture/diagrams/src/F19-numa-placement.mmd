        LOAD1["Private genome allocation"]
        CONCENTRATE["Pages initially concentrated<br/>near loading activity"]
        MIGRATE["Automatic NUMA balancing<br/>migration and fault work"]
        WORK1["96 mapping workers"]
        LOAD1 --> CONCENTRATE --> MIGRATE --> WORK1
    end

    subgraph A05["A05 accepted Labs candidate - not released"]
        direction LR
        REQUEST{"Auto policy eligible?<br/>alignReads + private genome<br/>at least 64 threads + multiple nodes"}
        INHERITED{"Caller supplied NUMA policy?"}
        PRESERVE["Preserve bind, preferred,<br/>local, or interleave subset"]
        FALLBACK["Retain inherited default<br/>lower threads, shared mode,<br/>or unsupported platform"]
        APPLY["Interleave across<br/>process-allowed memory nodes"]
        LOAD2["Load same genome<br/>run same mapping kernels"]
        REQUEST -->|No| FALLBACK
        REQUEST -->|Yes| INHERITED
        INHERITED -->|Yes| PRESERVE
        INHERITED -->|Default| APPLY --> LOAD2
    end

    SCREEN --> REQUEST
    WORK1 -.->|Runtime parent| REQUEST

    subgraph RESULTS["Exact 91de892 public evidence at 96 threads"]
        direction LR
        PRIMARY["Uncompressed full corpus<br/>74.01 s to 57.35 s<br/>22.51% median gain"]
        RESOURCE["Peak RSS change -0.13%<br/>3 of 3 paired outputs passed<br/>64-thread boundary gain 14.27%"]
        GZIP["Gzip support<br/>78.31 s to 62.25 s<br/>5 of 5 paired outputs passed"]
