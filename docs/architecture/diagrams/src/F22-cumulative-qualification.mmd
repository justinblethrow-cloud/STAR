flowchart TD
    RELEASE["Qualified blackstar.1<br/>benchmark control"] --> STACK["Cumulative Labs stack<br/>H01 + A02 + A05 + A06"]

    STACK --> PERF["REPLICATED PERFORMANCE"]
    PERF --> U["Uncompressed full corpus<br/>84.28 s to 56.17 s<br/>33.20% median paired gain; 3/3 exact"]
    PERF --> Z["zcat full corpus<br/>90.61 s to 64.03 s<br/>28.54% median paired gain; 3/3 exact"]

    STACK --> SAFETY["RUNTIME SAFETY"]
    SAFETY --> SHARED["Shared index + unsorted BAM<br/>5/5 checks; canonical BAM exact<br/>load and remove lifecycle passed"]
    SAFETY --> BOUND["Inherited OpenMP binding<br/>226.13 s to 37.69 s<br/>one-pair failure control; 3/3 exact"]

    STACK --> HARDEN["FUNCTIONAL HARDENING"]
    HARDEN --> TESTS["8/8 sanitizer scripts<br/>24/24 insertion checks<br/>4/4 SAindex checks"]
    HARDEN --> COMPAT["Official STAR 2.7.11b oracle<br/>full-index alignment compatible"]

    STACK --> PACKAGE["REPRODUCIBLE PACKAGING"]
    PACKAGE --> REPRO["Two clean builds<br/>binary, archive, and build-info<br/>digests identical"]

    U --> DECISION["TECHNICALLY QUALIFIED IN LABS"]
    Z --> DECISION
    SHARED --> DECISION
    BOUND --> DECISION
    TESTS --> DECISION
    COMPAT --> DECISION
    REPRO --> DECISION
    DECISION --> BOUNDARY["NOT PROMOTED, VERSIONED,<br/>TAGGED, OR RELEASED"]

    classDef release fill:#dcfce7,stroke:#15803d,color:#111827;
    classDef candidate fill:#dbeafe,stroke:#1d4ed8,color:#111827;
    classDef gate fill:#f3f4f6,stroke:#4b5563,color:#111827;
    classDef passed fill:#ecfdf5,stroke:#047857,color:#111827;
    classDef boundary fill:#fef3c7,stroke:#a16207,color:#111827;
    class RELEASE release;
    class STACK,DECISION candidate;
    class PERF,SAFETY,HARDEN,PACKAGE gate;
    class U,Z,SHARED,BOUND,TESTS,COMPAT,REPRO passed;
    class BOUNDARY boundary;
